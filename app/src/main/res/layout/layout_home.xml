<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewmodel"
            type="com.jmrsa.moviecrudapp.presentation.fragments.home.HomeViewModel" />
    </data>

    <ScrollView
        android:id="@+id/scrollViewHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginStart="30dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="28dp"
                app:cardCornerRadius="200dp"
                app:cardElevation="5dp"
                app:layout_constraintEnd_toStartOf="@+id/sectionProfileInfo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imageProfile"
                    android:background="@drawable/circular_picture"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/placeholder_image_picker"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/movie_crud_img_picker_cd"
                    android:scaleType="centerCrop" />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/sectionProfileInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="28dp"
                android:orientation="vertical"
                app:layout_constraintStart_toEndOf="@+id/cardProfile"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:text="@string/movie_crud_label_greeting" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:text="@{viewmodel.viewState.user.userName}"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/buttonSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/rounded_corner_input"
                android:contentDescription="@string/movie_crud_search_icon_cd"
                android:elevation="5dp"
                android:layout_marginBottom="28dp"
                android:src="@drawable/ic_search"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/labelYourFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/movie_crud_label_your_favorites"
                android:layout_marginTop="27dp"
                android:paddingTop="30dp"
                android:paddingBottom="20dp"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textAllCaps="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sectionProfileInfo" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMovieFavorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                app:layout_constraintTop_toBottomOf="@+id/labelYourFavorites" />

            <TextView
                android:id="@+id/labelStaffPicks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/movie_crud_label_staff_picks"
                android:layout_marginTop="40dp"
                android:textColor="@color/black"
                android:paddingBottom="20dp"
                android:textSize="12sp"
                android:textAllCaps="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvMovieFavorites" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStaffPicks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                app:layout_constraintTop_toBottomOf="@+id/labelStaffPicks" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
</layout>