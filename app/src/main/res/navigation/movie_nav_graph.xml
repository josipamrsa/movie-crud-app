<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/movie_nav_graph"
    app:startDestination="@id/signUpFragment">

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.jmrsa.moviecrudapp.presentation.fragments.signup.SignUpFragment"
        android:label="SignUpFragment">
        <action
            android:id="@+id/action_signUpFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.jmrsa.moviecrudapp.presentation.fragments.home.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
        <action
            android:id="@+id/action_homeFragment_to_detailsBottomSheet"
            app:destination="@id/detailsBottomSheet">
        </action>
        <action
            android:id="@+id/action_homeFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />

    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.jmrsa.moviecrudapp.presentation.fragments.search.SearchFragment"
        android:label="SearchFragment">
        <action
            android:id="@+id/action_searchFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_searchFragment_to_detailsBottomSheet"
            app:destination="@id/detailsBottomSheet">
        </action>
        <action
            android:id="@+id/action_searchFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />

    </fragment>
    <dialog
        android:id="@+id/detailsBottomSheet"
        android:name="com.jmrsa.moviecrudapp.presentation.fragments.details.DetailsBottomSheetFragment"
        android:label="DetailsBottomSheet">
        <argument
            android:name="movieDetails"
            app:argType="com.jmrsa.moviecrudapp.presentation.models.AppMovie"
            app:nullable="false" />
        <action
            android:id="@+id/action_detailsBottomSheet_to_signUpFragment"
            app:destination="@id/signUpFragment" />
    </dialog>
</navigation>